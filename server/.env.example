# 复制为 server/.env 后填写。.env 已被 .gitignore 忽略，不会提交到仓库。
#
# 规矩：这个文件里只放占位符，**真实密钥一律不写进来**。
#   - 值保持为空 = 应用会认为"没配置"，并在界面上如实标注（未配置模型时走规则兜底）；
#     所以不要为了"看起来完整"填上假的 key，否则应用会拿着假 key 去请求、报出难懂的鉴权错误。
#   - 提交前跑一次 .venv\Scripts\python.exe scripts\check_no_secrets.py
#   - 万一真把密钥提交了：先去服务商后台作废重发（这一步不能省），再清理仓库历史。

# ---- 文档解析：TextIn xParse ----
TEXTIN_APP_ID=
TEXTIN_SECRET_CODE=
TEXTIN_BASE_URL=https://api.textin.com
# 超过该页数的文件走异步解析接口（避免 HTTP 超时）
TEXTIN_ASYNC_PAGE_THRESHOLD=30

# ---- 大模型：DeepSeek（OpenAI 兼容协议） ----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=180

# ---- 服务与存储 ----
DATABASE_URL=sqlite:///./data/fitwise.db
STORAGE_DIR=./data/uploads
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183,http://127.0.0.1:5173,http://localhost:5173
